{
  "name": "homebot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "db:migrate": "wrangler d1 migrations apply HOME_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply HOME_DB --remote",
    "deploy": "wrangler deploy",
    "webhook": "node scripts/register-telegram-webhook.mjs",
    "deploy:production": "npm run db:migrate:remote && npm run deploy && npm run webhook"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  }
}
